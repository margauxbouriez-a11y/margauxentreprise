# Copie ce fichier en .env (en local) ou ajoute ces variables sur ton hébergeur.

# Mot de passe pour se connecter à la plateforme
ADMIN_PASSWORD=choisis-un-mot-de-passe-solide

# Clé secrète que n8n envoie dans l'en-tête X-API-Key (génère-la avec : openssl rand -hex 24)
N8N_API_KEY=remplace-par-une-longue-cle-aleatoire

# Secret pour signer les sessions (une autre longue chaîne aléatoire)
SESSION_SECRET=remplace-par-une-autre-cle-aleatoire

# Adresse publique de la plateforme (sert à pré-remplir les nœuds n8n)
PUBLIC_URL=https://ta-plateforme.onrender.com

# Emplacement de la base de données (doit être sur un disque persistant en production)
DB_PATH=./data/plateforme.db

# Nombre de jours avant la relance, et nombre maximum d'emails par entreprise
RELANCE_JOURS=4
MAX_EMAILS_PAR_PROSPECT=3

PORT=3000
